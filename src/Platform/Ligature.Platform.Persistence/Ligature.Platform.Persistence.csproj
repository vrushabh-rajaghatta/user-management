<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Ligature.Platform.Persistence.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ligature.Platform.Domain\Ligature.Platform.Domain.csproj" />
    <ProjectReference Include="..\Ligature.Platform.Application\Ligature.Platform.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Audit DDL is embedded, not read from disk, so a deployed image carries
      the exact scripts its release was built from. AuditSchemaDeployer
      applies them; they are deliberately not EF migrations, because an
      EF-created audit table would be owned by migration_role and an owner
      can drop what it owns. See Audit/AuditSchemaDeployer.cs.
    -->
    <EmbeddedResource Include="Audit\Schema\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
