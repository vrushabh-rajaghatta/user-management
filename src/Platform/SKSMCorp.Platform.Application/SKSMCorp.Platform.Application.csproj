<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Persistence implements the audit writer, which is internal so that
      handlers — which live in this assembly — have no public seam to it
      (IMPL-02). The test projects see internals for the same reason the
      Persistence tests do.
    -->
    <InternalsVisibleTo Include="SKSMCorp.Platform.Persistence" />
    <InternalsVisibleTo Include="SKSMCorp.Platform.Application.Tests" />
    <InternalsVisibleTo Include="SKSMCorp.Platform.Persistence.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\SKSMCorp.SharedKernel\SKSMCorp.SharedKernel.csproj" />
    <ProjectReference Include="..\SKSMCorp.Platform.Domain\SKSMCorp.Platform.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
